<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modal_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pulse_dot"
        android:backgroundTint="@color/border_subtle" />

    <!-- Video Preview Card Mockup -->
    <RelativeLayout
        android:id="@+id/cardVideoPlayer"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_video_box">

        <!-- Dark Mock Screen -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1E293B" />

        <!-- Red Play Button -->
        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_video_play" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="14dp"
            android:background="#80000000"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/watch_video_guide_60_seconds"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/how_to_create_account_deposit"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:text="@string/follow_these_3_easy_steps"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Step 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_action_circle_emerald"
            android:gravity="center"
            android:text="@string/t_1"
            android:textColor="@color/power_green_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/send_a_message_to_our"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Step 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_action_circle_emerald"
            android:gravity="center"
            android:text="@string/t_2"
            android:textColor="@color/power_green_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/get_your_login_id_and"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Step 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_action_circle_emerald"
            android:gravity="center"
            android:text="@string/t_3"
            android:textColor="@color/power_green_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/login_and_deposit_using_jazzcash"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- WhatsApp CTA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVideoWhatsAppAgent"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/power_green_primary"
        android:text="@string/contact_us_on_whatsapp"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_whatsapp"
        app:iconGravity="textStart"
        app:iconTint="@null" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismissVideoGuide"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="@color/bg_card"
        android:text="@string/close"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:strokeColor="@color/border_subtle"
        app:strokeWidth="1dp" />
</LinearLayout>
